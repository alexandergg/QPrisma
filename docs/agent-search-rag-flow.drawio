<mxCell id="z2_callmodel" value="&lt;b&gt;call_model&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot; color=&quot;#666&quot;&gt;• Dynamic system prompt&lt;br&gt;(single/multi/no-video)&lt;br&gt;• Dynamic tool selection (max 8)&lt;br&gt;• Context assembly pipeline:&lt;br&gt;- Trim messages (80k tokens)&lt;br&gt;- Hybrid memory (1.2-2.2k chars)&lt;br&gt;- Artifact rehydration (max 2, ~3.5k)&lt;br&gt;• Iteration guards: 10 calls, 3 errors&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=10;shadow=1;" vertex="1" parent="z2"><mxGeometry x="390" y="60" width="240" height="170" as="geometry"/></mxCell>

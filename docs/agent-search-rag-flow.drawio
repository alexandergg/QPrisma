<mxCell id="n3" value="&lt;b&gt;Tool Design Patterns&lt;/b&gt;&lt;br&gt;• Todas las tools retornan dicts, nunca excepciones&lt;br&gt;• Timeout 30s en search tools con keyword fallback&lt;br&gt;• Entity network: graph traversal 1-3 hops con score decay&lt;br&gt;• Highlight tools generan clips con timestamps para frontend&lt;br&gt;• Dynamic selection reduce latencia y token usage" style="shape=note;size=15;fillColor=#FFFFCC;strokeColor=#B3B300;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;spacingRight=4;whiteSpace=wrap;html=1;shadow=1;" vertex="1" parent="z3"><mxGeometry x="1370" y="610" width="330" height="130" as="geometry"/></mxCell>

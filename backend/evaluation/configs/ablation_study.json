      "is_baseline": false
    },
    {
      "name": "qprisma-flat",
      "display_name": "QPrisma (Flat Embeddings)",
      "description": "Vector-only scoring, no graph/temporal signals",
      "is_baseline": false
    },
    {
      "name": "qprisma-vectoronly",
      "display_name": "QPrisma (Vector Only)",
      "description": "Vector similarity only, no reranking, no expansion",
      "is_baseline": false
    },
    {
      "name": "qprisma-norerank",
      "display_name": "QPrisma (No Re-ranking)",
      "description": "Full pipeline minus LLM re-ranking",
      "is_baseline": false
    },
    {
      "name": "qprisma-visualonly",
      "display_name": "QPrisma (Visual Only)",
      "description": "Only visual frame analysis, no audio/transcript",

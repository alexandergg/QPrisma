    },
    {
      "name": "qprisma-audioonly",
      "display_name": "QPrisma (Audio Only)",
      "description": "Only transcript/audio, no visual frames",
      "is_baseline": false
    },
    {
      "name": "qprisma-fixedtokens",
      "display_name": "QPrisma (Fixed Tokens)",

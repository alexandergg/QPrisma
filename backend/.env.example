# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com/
# Set to true in Azure Container Apps to use managed identity instead of API keys
AZURE_USE_MANAGED_IDENTITY=false
AZURE_OPENAI_API_KEY=your_key_here
AZURE_OPENAI_DEPLOYMENT_GPT=gpt-4o
AZURE_OPENAI_DEPLOYMENT_EMBEDDING=text-embedding-3-large
AZURE_OPENAI_DEPLOYMENT_WHISPER=whisper
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Azure OpenAI Batch API (50% cost savings)
# Create a "Global Batch" deployment in Azure OpenAI Studio
AZURE_OPENAI_DEPLOYMENT_GPT_BATCH=gpt-4o-global-batch
BATCH_CHECK_INTERVAL_SECONDS=30
BATCH_MAX_WAIT_TIME_SECONDS=3600

# Azure Storage
# In Azure, prefer the account URL with managed identity instead of a connection string
AZURE_STORAGE_ACCOUNT_URL=https://yourstorageaccount.blob.core.windows.net
AZURE_STORAGE_CONNECTION_STRING=your_connection_string_here
AZURE_STORAGE_CONTAINER_NAME=media

# PostgreSQL (replaces Cosmos DB)
DATABASE_URL=postgresql://qprisma:qprisma123@localhost:5432/qprisma

# Neo4j Knowledge Graph
# Local dev: bolt://localhost:7687 (docker-compose)
# AuraDB:    neo4j+s://xxxx.databases.neo4j.io (TLS enabled)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=qprisma123

# Redis
REDIS_URL=redis://localhost:6379/0

# Tool Artifact Storage (full tool outputs)
ARTIFACT_CACHE_TTL_SECONDS=21600
ARTIFACT_CACHE_KEY_PREFIX=tool_artifact
ARTIFACT_BLOB_PREFIX=tool-artifacts

# Foundry Memory Store
FOUNDRY_MEMORY_STORE_NAME=qprisma-memory
FOUNDRY_MEMORY_CHAT_MODEL=gpt-4o
FOUNDRY_MEMORY_EMBEDDING_MODEL=text-embedding-3-large

# Foundry Project / Agent
FOUNDRY_PROJECT_ENDPOINT=https://your-project.services.ai.azure.com/api/projects/your-project-name
FOUNDRY_AGENT_NAME=qprisma-video-agent

# Microsoft Entra ID Authentication
ENTRA_TENANT_ID=87a75d4e-22bb-43dd-8b2d-8c8613a17b35
ENTRA_CLIENT_ID=8265aaf6-0f01-4649-81e0-01d040bebce2
ENTRA_API_SCOPE=api://8265aaf6-0f01-4649-81e0-01d040bebce2/access_as_user

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Application
APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000
